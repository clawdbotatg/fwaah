# Copy to .env and point at your own node. `.env` is gitignored.

# Dev server (`npm start`): where the /rpc proxy forwards JSON-RPC calls.
# Your local/LAN node, or an Alchemy URL — anything that speaks eth JSON-RPC.
NODE_RPC_URL=http://127.0.0.1:8545

# Production build (`npm run build`): RPC URL baked into the client bundle.
# Only for self-hosted forks — DON'T put a keyed URL here if the build is public;
# fwaah.com itself uses the /api/rpc proxy (RPC_UPSTREAM env on Vercel) instead.
# REACT_APP_RPC_URL=http://your-node:8545
